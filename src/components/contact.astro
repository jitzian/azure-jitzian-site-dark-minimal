<section id="contact" class="w-full py-12 border-t border-[#ffffff10]">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">Let's talk</h2>
    <h3 class="text-4xl md:text-5xl font-medium text-[var(--white)] mb-6">
      Contact
    </h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="text-[var(--white-icon)]">
        <p class="mb-4">
          Have a question, an opportunity or a project in mind? Feel free to reach out.
        </p>
        <div class="flex items-center gap-2">
          <span>Location:</span>
          <span class="text-[var(--white)]">Columbus, OH, USA</span>
        </div>
        <div class="flex items-center gap-2 mt-2">
          <span>Email:</span>
          <a
            href="mailto:jonathan.sandoval@live.com"
            class="text-[var(--white)] hover:text-[var(--sec)] transition-colors"
            >jonathan.sandoval@live.com</a
          >
        </div>
      </div>

      <div>
        <form
          id="contact-form"
          class="flex flex-col gap-4"
        >
          <input
            type="text"
            name="from_name"
            placeholder="Name"
            required
            class="px-4 py-2 bg-[#1414149c] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--sec)]"
          />
          <input
            type="email"
            name="reply_to"
            placeholder="Email"
            required
            class="px-4 py-2 bg-[#1414149c] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--sec)]"
          />
          <textarea
            name="message"
            placeholder="Message"
            rows="6"
            required
            class="px-4 py-2 bg-[#1414149c] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--sec)] resize-none"
          ></textarea>
          <button
            type="submit"
            class="px-4 py-2 bg-[var(--white-icon-tr)] text-[var(--white)] rounded-lg opacity-60 transition-opacity border border-[var(--white-icon-tr)] hover:opacity-100 hover:bg-[var(--white-icon-tr)]"
          >
            Send email
          </button>
        </form>
        <div id="form-message" class="hidden flex-col gap-3 mt-4 text-[var(--white)]">
          <p>
            ✅ Your message is ready. If your email app didn't open, use one of
            these:
          </p>
          <div class="flex flex-wrap gap-2 text-sm">
            <a
              id="open-gmail"
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-2 rounded-lg border border-[var(--white-icon-tr)] hover:bg-[var(--white-icon-tr)] transition-colors"
              >Open in Gmail</a
            >
            <a
              id="open-outlook"
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-2 rounded-lg border border-[var(--white-icon-tr)] hover:bg-[var(--white-icon-tr)] transition-colors"
              >Open in Outlook</a
            >
            <button
              id="copy-message"
              type="button"
              class="px-3 py-2 rounded-lg border border-[var(--white-icon-tr)] hover:bg-[var(--white-icon-tr)] transition-colors"
              >Copy message</button
            >
          </div>
          <p class="text-sm text-[var(--white-icon)]">
            Or write directly to
            <span class="text-[var(--white)]">jonathan.sandoval@live.com</span>.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script type="module" is:inline>
  const TO = "jonathan.sandoval@live.com";
  const form = document.getElementById("contact-form");
  const formMessage = document.getElementById("form-message");

  // Static site with no backend: hand the message to the visitor's mail client,
  // and always offer webmail / copy fallbacks since many browsers have no mailto handler.
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const subject = `Portfolio contact from ${data.get("from_name")}`;
    const body = `${data.get("message")}\n\n${data.get("from_name")} <${data.get("reply_to")}>`;
    const q = (o) => new URLSearchParams(o).toString().replace(/\+/g, "%20");

    document.getElementById("open-gmail").href =
      "https://mail.google.com/mail/?" + q({ view: "cm", fs: "1", to: TO, su: subject, body });
    document.getElementById("open-outlook").href =
      "https://outlook.live.com/mail/0/deeplink/compose?" + q({ to: TO, subject, body });
    document.getElementById("copy-message").onclick = async (ev) => {
      try {
        await navigator.clipboard.writeText(`To: ${TO}\nSubject: ${subject}\n\n${body}`);
        ev.target.textContent = "Copied!";
      } catch {
        ev.target.textContent = "Copy failed";
      }
    };

    formMessage.classList.remove("hidden");
    formMessage.classList.add("flex");

    const mailto = document.createElement("a");
    mailto.href = `mailto:${TO}?` + q({ subject, body });
    document.body.appendChild(mailto);
    mailto.click();
    mailto.remove();
  });
</script>
